<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_0_1"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:minHeight="?attr/actionBarSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dokitaPrimary"
        app:theme="@style/ThemeOverlay.AppCompat">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/toolbar_title"
            android:text="CDOC"
            android:textColor="@color/white"
            android:textSize="20sp"/>

        <Button
            android:id="@+id/skipBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:textSize="12sp"
            android:background="@null"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:textColor="@color/white"
            android:text="Skip"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:id="@+id/focus_thief"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gray_0_5"
            android:scrollbars="none">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/personalInfoTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:hint="Personal Information"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weightTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Weight"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <EditText
                            android:id="@+id/weightEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />



                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />
                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/txtLb"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sex_male"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:text="lb" />

                        <TextView
                            android:id="@+id/txtKg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sex_female"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:text="kg" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/heightTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Height"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/heightEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="number"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp"
                            android:focusableInTouchMode="false" />


                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtFt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sex_male"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:text="ft" />

                        <TextView
                            android:id="@+id/txtCm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sex_female"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:text="cm" />

                    </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/bloodPressureTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Blood Pressure"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <EditText
                            android:id="@+id/bloodPressureHighEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/bloodPressureHighTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hint="/"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />


                        <EditText
                            android:id="@+id/bloodPressureLowEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/bloodPressureLowTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hint="mmHg"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pulseTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:hint="Pulse"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <EditText
                            android:id="@+id/pulseEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="3"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/pulseUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="bpm"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tempTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="Temperature"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />


                        <EditText
                            android:id="@+id/tempEdit"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:background="@drawable/bg_border_radius_gray"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/txtF"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sex_male"
                                android:gravity="center"
                                android:paddingBottom="8dp"
                                android:paddingTop="8dp"
                                android:text="F" />

                            <TextView
                                android:id="@+id/txtC"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sex_female"
                                android:gravity="center"
                                android:paddingBottom="8dp"
                                android:paddingTop="8dp"
                                android:text="C" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>


                <TextView
                    android:id="@+id/chiefComplaintTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Reason for Visit:"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">


                    <com.guna.libmultispinner.MultiSelectionSpinner
                        android:id="@+id/chiefComplaintSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />


                    <EditText
                        android:id="@+id/chiefComplaintEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_border_radius_gray"
                        android:hint="others:"
                        android:maxLength="200"
                        android:paddingBottom="8dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:textSize="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/ldnConsultTxt"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            android:hint="Intial Consult For LDN"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <CheckBox
                            android:id="@+id/ldnConsultCheck"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:onClick="ldnFollowUpSelect"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <TextView
                            android:id="@+id/ldnFollowUpTxt"
                            android:layout_width="250dp"
                            android:layout_height="wrap_content"
                            android:hint="LDN Refill Consultation Follow Up"
                            android:maxLength="25"
                            android:paddingBottom="8dp"
                            android:paddingTop="8dp"
                            android:singleLine="true"
                            android:textSize="14dp" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="match_parent" />

                        <CheckBox
                            android:id="@+id/ldnFollowUpCheck"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:onClick="ldnConsultSelect"/>

                    </LinearLayout>

                </LinearLayout>


                <TextView
                    android:id="@+id/smokeStatusTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Smoking Status:"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">


                    <Spinner
                        android:id="@+id/smokeStatusSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />

                </LinearLayout>


                <TextView
                    android:id="@+id/socialHxTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Other Social History:"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <EditText
                        android:id="@+id/socialHxEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_border_radius_gray"
                        android:maxLength="200"
                        android:paddingBottom="8dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:textSize="14dp"
                        android:paddingRight="50dp"/>

                        <ImageButton
                            android:id="@+id/socialHxQ"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/question_mark"
                            android:layout_centerVertical="true"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="3dp"
                            android:layout_marginLeft="3dp"
                            android:layout_alignParentRight="true"/>

                    </RelativeLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/allergiesTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Allergies:"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <com.guna.libmultispinner.MultiSelectionSpinner
                        android:id="@+id/allergiesSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />

                    <EditText
                        android:id="@+id/allergiesEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_border_radius_gray"
                        android:maxLength="200"
                        android:paddingBottom="8dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:textSize="14dp" />

                </LinearLayout>


                <TextView
                    android:id="@+id/medHxTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Medical History:"
                    android:paddingBottom="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/linear_layout_border"
                    android:orientation="vertical"
                    android:padding="10dp">


                    <com.guna.libmultispinner.MultiSelectionSpinner
                        android:id="@+id/medHxSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown" />

                    <EditText
                        android:id="@+id/medHxEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_border_radius_gray"
                        android:hint="others:"
                        android:maxLength="200"
                        android:paddingBottom="8dp"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:textSize="14dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnConsult"
                    android:layout_width="320dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/selector_btn_consult_blue_corner"
                    android:text="@string/vitals_consult"
                    android:textColor="@color/white_2_1"
                    android:textSize="@dimen/font_size_18" />

                <Button
                    android:id="@+id/btnWaitRoom"
                    android:layout_width="320dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/selector_btn_consult_orange_corner"
                    android:text="Enter Waiting Room"
                    android:textColor="@color/white_2_1"
                    android:textSize="@dimen/font_size_18" />
            </LinearLayout>

        </ScrollView>

    </RelativeLayout>
</LinearLayout>