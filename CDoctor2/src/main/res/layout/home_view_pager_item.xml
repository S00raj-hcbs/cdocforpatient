<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <androidx.cardview.widget.CardView
        android:id="@+id/card1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:elevation="@dimen/_5sdp"
        android:visibility="visible"
        app:cardCornerRadius="@dimen/_5sdp"
       >

         <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_c0ddee"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:gravity="center|start"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/manage_your"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/font_size_13" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/family_health"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/font_size_17" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"

                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/in_one_place"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/font_size_13" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_height="@dimen/_75sdp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"

                android:src="@drawable/home_screen_1_img" />
         </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:elevation="@dimen/_5sdp"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/_5sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_7bc6ec"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                android:gravity="center|start"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/see_your_doc"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/font_size_17"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/anywhere_anytime"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/font_size_15"
                    />

            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_gravity="bottom"
                android:layout_height="@dimen/_75sdp"
                android:scaleType="fitXY"
                android:src="@drawable/home_screen_2_img"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_10sdp"
        android:elevation="@dimen/_5sdp"
        app:cardCornerRadius="@dimen/_5sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_3ca7d6"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/_100sdp"
            android:gravity="center|start"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_19sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/monitor_your"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/font_size_13"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_19sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="@string/vital_sign_home"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/font_size_17" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_19sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/share_with_doc"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/font_size_13"
                   />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_75sdp"
                android:layout_gravity="bottom"
                android:scaleType="fitXY"
                android:src="@drawable/home_screen_3_img"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
