<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/_10sdp"
    app:cardCornerRadius="@dimen/_5sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgclose"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_signup_cross"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:padding="@dimen/_2sdp"
            android:layout_gravity="end"/>
        <TextView
            android:id="@+id/txtlabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_centerHorizontal="true"
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/dark_slate_blue"
            android:fontFamily="@font/roboto_medium"
           android:gravity="center"
            android:visibility="gone"
            android:text="@string/please_add_family_member_n_to_add_them_on_the_call"
            />
        <Button
            android:id="@+id/btn_personal_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:text="@string/add_by_patient_info"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:textAllCaps="false"
            android:layout_below="@+id/imgclose"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/azure"
            android:background="@drawable/bg_outline_blue"
            />
        <Button
            android:id="@+id/btn_email"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_30sdp"
            android:text="@string/add_by_cdoc_account"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:textAllCaps="false"
            android:layout_below="@+id/btn_personal_info"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/azure"
            android:background="@drawable/bg_outline_blue"
            android:layout_marginBottom="@dimen/_18sdp"
            />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
