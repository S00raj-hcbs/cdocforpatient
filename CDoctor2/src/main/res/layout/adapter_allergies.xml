<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_outline_blue_immunization"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">




            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/lin_dose"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/name"
                        android:textColor="#8d6796"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/med_drug_info"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/roboto_regular"
                        android:text=""
                        android:layout_marginTop="@dimen/_5sdp"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_11sdp"
                        android:textStyle="normal" />



                </LinearLayout>
                <LinearLayout
                    android:id="@+id/lin_dose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/status"
                        android:textColor="#8d6796"
                        android:layout_gravity="right"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/med_drug_info"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/roboto_regular"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_11sdp"
                        android:textStyle="normal" />



                </LinearLayout>

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/severity"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="#8d6796"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />
            <TextView
                android:id="@+id/tv_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/med_drug_info"
                android:layout_centerVertical="true"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_11sdp"
                android:textStyle="normal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/reaction_notes"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="#8d6796"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal" />
            <TextView
                android:id="@+id/tv_Reaction_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/med_drug_info"
                android:layout_centerVertical="true"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_11sdp"
                android:textStyle="normal" />
        </LinearLayout>



    </RelativeLayout>
</layout>