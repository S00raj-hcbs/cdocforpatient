<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.cybermed.cdoc_patient.login.viewmodel.SignUpVM" />
    </data>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sign_up"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_46sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtsignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_gravity="left"
                android:layout_marginStart="@dimen/_14sdp"
                android:drawableStart="@drawable/ic_back_btn"
                android:drawablePadding="@dimen/_13sdp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/sign_up"
                android:textAllCaps="false"
                android:textColor="@color/dark_slate_blue"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_signin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_14sdp"
                android:background="@drawable/bg_outine_blue_corner"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:paddingTop="@dimen/_7sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:paddingStart="@dimen/_15sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:text="@string/sign_in"
                android:textAllCaps="false"
                android:textColor="@color/azure"
                android:textSize="@dimen/_10sdp"
                android:visibility="visible" />


            <ImageView
                android:id="@+id/img_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/ic_signup_cross"
                android:visibility="gone" />

        </RelativeLayout>

        <include
            android:id="@+id/layout_logo"
            layout="@layout/logo_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/title_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_18sdp"

            android:fontFamily="@font/roboto_medium"
            android:text="@string/select_mode"
            android:textColor="@color/dark_slate_blue"
            android:textSize="@dimen/_20sdp"
            android:textStyle="normal" />

        <com.cybermed.cdoc_patient.widget.ProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:defaultIcon="@drawable/ic_progress_circle"
            app:defaultProgressLine="@drawable/line_1"
            app:max="4"
            app:processedIcon="@drawable/ic_progress_complete"
            app:progressIcon="@drawable/ic_progress_filled"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"/>
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


    </LinearLayout>
</layout>
