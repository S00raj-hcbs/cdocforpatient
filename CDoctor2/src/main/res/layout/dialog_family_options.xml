<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@null">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/family_option_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_cancel">

        <TextView
            android:id="@+id/provider_name_txt"
            android:layout_width="@dimen/family_option"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/family_option_title_gray"
            android:gravity="center"
            android:text="Provider"
            android:textSize="26sp"
            app:layout_constraintBottom_toTopOf="@+id/callBackBtn"
            app:layout_constraintEnd_toEndOf="@+id/callBackBtn"
            app:layout_constraintStart_toStartOf="@+id/callBackBtn"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/callBackBtn"
            android:layout_width="310dp"
            android:layout_height="130dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/btn_appt_call"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/provider_name_txt"
            app:layout_constraintDimensionRatio="w,1:1"/>

        <TextView
            android:id="@+id/deleteBtn"
            android:layout_width="310dp"
            android:layout_height="80dp"
            android:text="@string/dialog_family_options_cancel_appt"
            android:textColor="@color/white_0_2"
            android:background="#ff2600"
            android:textSize="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal|center_vertical"
            app:layout_constraintTop_toBottomOf="@id/callBackBtn"
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/send_image"
            android:layout_width="310dp"
            android:layout_height="80dp"
            android:text="@string/dialog_family_options_send_img"
            android:textColor="@color/white_0_2"
            android:background="@color/blue"
            android:textSize="25dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal|center_vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/deleteBtn"
            />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/btn_cancel"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:background="?android:selectableItemBackground"
        android:src="@drawable/btn_appt_cancel"
        app:layout_constraintTop_toBottomOf="@+id/layout_options"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>