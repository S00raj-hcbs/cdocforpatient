<layout>

    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true">

        <com.cybermed.cdoc_patient.common.videoui.GridVideoViewContainer
            android:id="@+id/grid_video_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/video_background" />

        <ViewStub
            android:id="@id/small_video_view_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:inflatedId="@id/small_video_view_dock"
            android:layout="@layout/small_video_view_dock" />
        <ImageView
            android:id="@+id/back_btn_callConnected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back_btn"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_gravity="start"
            android:padding="@dimen/_10sdp"
            android:visibility="visible"
            android:background="@drawable/white_circle"
            />

        <!--after call connecting view-->
        <RelativeLayout
            android:id="@+id/view_call_connected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_22sdp"
            android:visibility="gone">

            <!--tittle-->
           <!-- <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_13sdp"
                android:fontFamily="@font/roboto_medium"
                android:text="Doctor Name"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_12sdp"
                android:visibility="visible" />-->


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="@dimen/_13sdp">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_weight="1">


                    <TextView
                        android:id="@+id/textName"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:text=""
                        android:textSize="@dimen/_10sdp"
                        android:padding="@dimen/_3sdp"
                        android:background="@drawable/background_username"
                        android:alpha="0.4"
                        />
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_toLeftOf="@+id/img_remoteuserstatus"
                            android:layout_centerVertical="true"
                            android:padding="@dimen/_3sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:text=""
                            android:textColor="@color/white_0_2"
                            android:textSize="@dimen/_10sdp"
                            android:visibility="visible" />
                        <ImageView
                            android:id="@+id/img_remoteuserstatus"
                            android:layout_width="@dimen/_10sdp"
                            android:layout_height="@dimen/_10sdp"
                            android:layout_centerVertical="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginRight="@dimen/_5sdp"
                            android:background="@drawable/networkicon"/>
                    </RelativeLayout>




                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_weight="1">


                    <ImageView
                        android:id="@+id/current_userstatus"
                        android:layout_width="@dimen/_8sdp"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginLeft="@dimen/_2sdp"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="@dimen/_2sdp"
                        android:background="@drawable/dot_seprator"
                        android:backgroundTint="@color/green"/>

                </RelativeLayout>


            </LinearLayout>

            <RelativeLayout
                android:id="@+id/loader_add_provider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_rectangle_outline"
                android:orientation="vertical"
                android:padding="@dimen/_5sdp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginRight="@dimen/_5sdp" />

                <TextView
                    android:id="@+id/txt_add_provider_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_toEndOf="@+id/progressBar"
                    android:text="@string/calling" />


                <ImageView
                    android:id="@+id/btn_end_invitation"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_below="@+id/txt_add_provider_status"
                    android:layout_centerInParent="true"
                    android:layout_margin="@dimen/_10sdp"
                    android:src="@drawable/btn_hangup"
                    android:visibility="gone" />
            </RelativeLayout>




            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/callCancelledTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="bottom|center"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:text="@string/call_cancelled"
                    android:textColor="@color/white_0_2"
                    android:visibility="gone" />


                <Chronometer
                    android:id="@+id/txt_call_timer"
                    android:layout_width="@dimen/_64sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:background="@drawable/ic_star_bg"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:padding="@dimen/_5sdp"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_12sdp" />
                <ImageView
                    android:id="@+id/btn_background"
                    android:layout_width="@dimen/_35sdp"
                    android:layout_height="@dimen/_35sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/backgroimg" />

                <TextView
                    android:id="@+id/txt_rejoin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:background="@drawable/bg_outine_blue_corner"
                    android:paddingStart="@dimen/_15sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="@string/rejoin"
                    android:visibility="gone"
                    android:textColor="@color/azure" />
                <com.cybermed.cdoc_patient.view.CdocLoadingDots
                    android:id="@+id/audio_animate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:visibility="invisible"
                    app:LoadingDots_auto_play="true"
                    app:LoadingDots_dots_color="@android:color/holo_blue_light"
                    app:LoadingDots_dots_count="4"
                    app:LoadingDots_dots_size="10dp"
                    app:LoadingDots_dots_space="1dp"
                    app:LoadingDots_jump_duration="200"
                    app:LoadingDots_jump_height="4dp"
                    app:LoadingDots_loop_duration="800"
                    app:LoadingDots_loop_start_delay="100" />

                <!--控制栏-->

                <LinearLayout
                    android:id="@+id/linear_control"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_below="@+id/txt_call_timer"
                    android:layout_marginTop="@dimen/_14sdp"

                    android:layout_marginBottom="@dimen/_32sdp"
                    android:background="@drawable/call_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/btnMute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:src="@drawable/selector_mute_btn" />

                    <ImageView
                        android:id="@+id/btnVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:src="@drawable/call_front_cam" />

                    <ImageView
                        android:id="@+id/btnFinish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/btn_hangup" />

                    <ImageView
                        android:id="@+id/btn_add_family"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/call_add"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/upload_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:src="@drawable/call_upload"
                        android:visibility="visible" />
                </LinearLayout>

                <!--                </androidx.constraintlayout.widget.ConstraintLayout>-->
            </RelativeLayout>


            <TextView
                android:id="@+id/txt_provider_status_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_25sdp"
                android:layout_gravity="center_vertical"
                android:layout_centerInParent="true"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:paddingLeft="@dimen/_6sdp"
                android:paddingRight="@dimen/_6sdp"
                android:textColor="@color/black_2_1"
                android:visibility="invisible"
                android:textSize="@dimen/_12sdp"
                android:background="@color/white_0_2" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/connectingPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:background="@color/dark_slate_blue"
            >
            <!-- android:background="@drawable/consult_bg_shape"-->
            <ImageView
                android:id="@+id/back_btn_connecting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/back_arrow"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:padding="@dimen/_10sdp"
                />
            <LinearLayout
                android:id="@+id/cancellingView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_loader"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/connectingTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp"
                    android:gravity="center"
                    android:text="@string/connecting_msg"
                    android:textColor="#fff"
                    android:textSize="20dp"
                    android:textStyle="bold" />

            </LinearLayout>


            <ImageButton
                android:id="@+id/endConnectionBtn"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="60dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_hangup"
                android:visibility="gone" />
        </RelativeLayout>

        <!--out going view-->
        <RelativeLayout
            android:id="@+id/view_outgoing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark_slate_blue"
            android:visibility="gone">
            <ImageView
                android:id="@+id/back_btn_outgoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/back_arrow"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:padding="@dimen/_10sdp"
                />
            <include
                android:id="@+id/view_outgoing_profile"
                layout="@layout/lay_call_profile_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/call_end"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true" />


            <ImageView
                android:id="@+id/call_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="@dimen/_40sdp"
                android:src="@drawable/btn_hangup" />
        </RelativeLayout>
        <!--call incoming view-->
        <RelativeLayout
            android:id="@+id/in_coming_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark_slate_blue"
            android:visibility="gone">
            <!-- android:background="@drawable/consult_bg_shape"-->
            <ImageView
                android:id="@+id/back_btn_incoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/back_arrow"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:padding="@dimen/_5sdp"
                android:visibility="gone"
                />

            <include
                android:id="@+id/view_incoming_profile"
                layout="@layout/lay_call_profile_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/btn_in_coming_hangup"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                android:layout_centerHorizontal="true" />

            <TextView
                android:id="@+id/callEndedTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="175dp"
                android:text="@string/call_ended"
                android:textColor="@color/white_0_2"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_in_coming_hangup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/_60sdp"
                android:layout_marginBottom="@dimen/_40sdp"
                android:onClick="btnFinishClick"
                android:src="@drawable/btn_hangup" />

            <ImageView
                android:id="@+id/btn_in_coming_answer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/_60sdp"
                android:layout_marginBottom="@dimen/_50sdp"
                android:onClick="btnFinishClick"
                android:src="@drawable/btn_accept_call" />

        </RelativeLayout>

    </FrameLayout>
</layout>
