<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        app:cardCornerRadius="@dimen/_5sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/root_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_5sdp">


            <ImageView
                android:id="@+id/iot_device_img"
                android:layout_width="42dp"
                android:layout_height="43dp"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:background="@drawable/devices_img_bg"
                android:padding="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/device_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_11sdp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toEndOf="@id/iot_device_img"
                app:layout_constraintTop_toTopOf="@id/iot_device_img" />

            <TextView
                android:id="@+id/measurement_time"
                android:layout_width="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/device_type" />

            <TextView
                android:id="@+id/measurement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/dark_slate_blue"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@id/device_type"
                app:layout_constraintTop_toBottomOf="@id/device_type" />

            <TextView
                android:id="@+id/txt_gluco_reading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_7sdp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/azure"
                android:textSize="@dimen/_9sdp"
                android:text="@string/routine_btn"
                android:gravity="end"
                app:layout_constraintStart_toEndOf="@id/measurement"
                app:layout_constraintTop_toTopOf="@id/measurement"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/_13sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/measurement" />
            <RelativeLayout
                android:id="@+id/measurement_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/measurement"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="@id/measurement">

                <TextView
                    android:id="@+id/label_sys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/sys"
                    android:layout_toStartOf="@+id/txt_sys"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/txt_sys"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_toStartOf="@+id/label_dia"
                    android:textColor="@color/color_cb544c"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:layout_marginStart="@dimen/_8sdp"
                    android:id="@+id/label_dia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_toStartOf="@+id/txt_dia"
                    android:text="@string/dia"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/txt_dia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:layout_alignParentEnd="true"
                    android:textColor="@color/color_cb544c"
                    android:textSize="@dimen/_10sdp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/txt_view_records"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:background="@drawable/bg_outline_blue_selector"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/view_records"
                android:textColor="@color/azure"
                android:textSize="@dimen/_10sdp"
                app:layout_constraintBottom_toBottomOf="@id/txt_meausre"
                app:layout_constraintEnd_toStartOf="@id/txt_meausre"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/txt_meausre"/>

            <TextView
                android:id="@+id/txt_meausre"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:background="@drawable/selector_blue_bg"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:paddingTop="@dimen/_6sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:text="@string/measure"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_10sdp"
                android:enabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/txt_view_records"
                app:layout_constraintTop_toBottomOf="@id/measurement" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>
