    <LinearLayout
        android:id="@+id/linear_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbar"
        android:orientation="vertical"
       android:paddingStart="@dimen/_14sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingTop="@dimen/_18sdp"
        tools:context=".activity.MapsActivity">

        <EditText
            android:alpha="0.9"
            android:textColorHint="@color/color_6896ae"
            android:background="@color/white_0_2"
            android:id="@+id/autoCompleteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableTint="@color/dark_slate_blue"
            android:textColor="@color/dark_slate_blue"
            android:fontFamily="@font/roboto_regular"
            android:textSize="@dimen/_12sdp"
            android:drawableStart="@drawable/map_auto_search"
            android:hint="@string/my_pharmacies_city_search"
            android:inputType="textPostalAddress"
            android:drawablePadding="@dimen/_10sdp"
            android:padding="@dimen/_10sdp" />
        <View
            android:layout_width="match_parent"
            android:background="@color/color_8f8f8f"
            android:layout_height="@dimen/_1sdp"
            android:alpha="0.9"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/places_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF"
            android:layout_marginTop="@dimen/_15sdp"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchBtn"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:textColor="@color/white_0_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_horizontal"
        android:textSize="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_38sdp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="@dimen/_21sdp"
        android:background="@drawable/selector_blue_bg"
        android:padding="@dimen/_9sdp"
        android:text="@string/my_pharmacies_show_pharm" />

    <Button
        android:id="@+id/favoriteBtn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@+id/pharmacyListBtn"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/maps_favorite"
        android:visibility="gone" />

    <Button
        android:id="@+id/pharmacyListBtn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_below="@id/linear_top"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/maps_pharmacy"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/pharmacyListLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pharmacyListBtn"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:background="@color/white_0_2"
        android:visibility="gone">

        <TextView
            android:id="@+id/favorite_pharmacy_list_txt"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/blue_0_5"
            android:gravity="center"
            android:text="@string/my_pharmacies_saved_pharm"
            android:textColor="@color/white_0_2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/favorite_pharmacy_list_txt">

        </ListView>

        <ImageView
            android:id="@+id/emptypharmacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:background="@drawable/icon_empty"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptypharmacytxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/emptypharmacy"
            android:layout_centerHorizontal="true"
            android:text="@string/my_pharmacies_no_pharm"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>

