<layout>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">


            <ProgressBar
                android:id="@+id/progressCircleSmaller"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_160sdp"
                android:layout_centerHorizontal="true"
                android:layout_margin="@dimen/_22sdp"
                android:indeterminateDrawable="@drawable/progress_darkslatesgrey" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/your_weight"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/txt_glucose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="--"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/_28sdp" />

                <TextView
                    android:id="@+id/weight_graph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/iot_lb"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:id="@+id/btn_view_history"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_38sdp"
            android:background="@drawable/bg_login_btn_selector"
            android:drawableEnd="@drawable/ic_white_arrow"
            android:drawablePadding="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:text="@string/view_full_history"
            android:textAllCaps="false"
            android:textColor="@color/white_0_2"
            android:textSize="@dimen/_12sdp"
            android:layout_alignParentBottom="true"/>


    </RelativeLayout>

</layout>