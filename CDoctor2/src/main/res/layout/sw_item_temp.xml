<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <import type="java.util.Map" />

        <variable
            name="utility"
            type="com.cybermed.cdoc_patient.bluetooth.iHealth_Devices.smartwatch.vital_graph.utility.Utility" />
        <variable
            name="DeviceKey"
            type="com.cybermed.cdoc_patient.bluetooth.iHealth_Devices.smartwatch.swUtil.SWKeyConstant" />

        <variable
            name="map"
            type="Map&lt;String, String&gt;" />
        <variable
            name="isConnected"
            type="androidx.lifecycle.MutableLiveData&lt;Boolean&gt;"/>
    </data>

    <LinearLayout
        android:layout_marginTop="@dimen/_28sdp"
        android:id="@+id/parent_temp"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_temp_per"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/temperature"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@color/dark_slate_blue"
                android:textSize="@dimen/_12sdp"/>

            <TextView
                android:id="@+id/text_temp_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_10sdp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_13sdp"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sw_title_bg_outline"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/_12sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:text="@string/temperature"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp"
                    app:drawableStartCompat="@drawable/sw_thermometer" />

                <TextView
                    android:id="@+id/txt_temperature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/sw_data_bg_outline"
                    android:fontFamily="@font/roboto_medium"
                    android:padding="@dimen/_15sdp"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/_12sdp"
                    app:drawableEndCompat="@drawable/ic_right_arrow_transparent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>