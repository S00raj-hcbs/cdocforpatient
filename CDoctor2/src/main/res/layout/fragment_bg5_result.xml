<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:id="@+id/img_circle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp">

                <ImageView
                    android:id="@+id/imgCircleBigger"
                    android:layout_width="@dimen/_190sdp"
                    android:layout_height="@dimen/_190sdp"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_circle_dark_slate" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="@string/your_gulcose_n_level"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/txt_glucose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="0"
                        android:textColor="@color/dark_slate_blue"
                        android:textSize="@dimen/_28sdp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/mg_dl"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp" />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/glucose_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/img_circle"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:drawablePadding="@dimen/_5sdp"
                android:gravity="center"
                android:text="Date"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_10sdp"
                app:drawableStartCompat="@drawable/ic_cal2" />


            <Spinner
                android:id="@+id/spinner_relationship"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_below="@+id/img_circle"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_toEndOf="@+id/glucose_date"
                android:background="@null"
                android:prompt="@string/measurement_time" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/spinner_relationship"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_toEndOf="@+id/glucose_date"
                android:background="@color/color_8f8f8f" />

            <Button
                android:id="@+id/btn_finish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_40sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                android:background="@drawable/bg_login_btn_selector"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/done"
                android:textAllCaps="false"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_12sdp" />

            <Button
                android:id="@+id/btn_view_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/view"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_30sdp"
                android:layout_marginTop="@dimen/_40sdp"
                android:background="@drawable/bg_login_btn_selector"
                android:drawableEnd="@drawable/ic_white_arrow"
                android:fontFamily="@font/roboto_medium"
                android:paddingStart="@dimen/_15sdp"
                android:paddingEnd="@dimen/_15sdp"
                android:text="@string/view_full_history"
                android:textAllCaps="false"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_12sdp"
                android:visibility="gone" />

        </RelativeLayout>
    </ScrollView>
</layout>

