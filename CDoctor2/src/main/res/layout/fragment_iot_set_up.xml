                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_outine_blue_corner"
                        android:drawablePadding="@dimen/_4sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:paddingStart="@dimen/_9sdp"
                        android:paddingTop="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_9sdp"
                        android:paddingBottom="@dimen/_4sdp"
                        android:text="@string/add"
                        android:textColor="@color/azure"
                        android:textSize="@dimen/_10sdp"
                        app:drawableStartCompat="@drawable/ic_add"
                        app:drawableTint="@color/dark_slate_blue"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white_0_2"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardUseCompatPadding="true"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_9sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_9sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/_14sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center_vertical"
                        android:text="@string/smart_watch"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        app:drawableStartCompat="@drawable/smart_watch_ic"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/card_smartwatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_outine_blue_corner"
                        android:drawablePadding="@dimen/_4sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:paddingStart="@dimen/_9sdp"
                        android:paddingTop="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_9sdp"
                        android:paddingBottom="@dimen/_4sdp"
                        android:text="@string/add"
                        android:textColor="@color/azure"
                        android:textSize="@dimen/_10sdp"
                        app:drawableStartCompat="@drawable/ic_add"
                        app:drawableTint="@color/dark_slate_blue"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>