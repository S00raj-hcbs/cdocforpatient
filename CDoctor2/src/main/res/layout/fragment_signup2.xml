<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>

        <variable
            name="vm"
            type="com.cybermed.cdoc_patient.login.viewmodel.SignUpVM" />
    </data>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical">


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_32sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:hint="@string/regist_firstname"
                android:textColorHint="@color/color_6896ae"
                app:errorEnabled="false"
                app:errorText="@{vm.firstNameError}"
                app:errorTextAppearance="@style/errorTextApprearance"
                app:hintTextAppearance="@style/customHintApprearance">

                <EditText
                    android:id="@+id/editFirstName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                    android:drawablePadding="@dimen/_13sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:inputType="text"
                    android:maxLength="25"
                    android:paddingBottom="@dimen/_13sdp"
                    android:singleLine="true"
                    android:text="@={vm.firstName}"
                    android:textColor="@color/color_4f4f4f"
                    android:textColorHighlight="@color/azure"
                    android:textSize="@dimen/_10sdp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_lastname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/input_first"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:hint="@string/regist_lastname"
                app:errorEnabled="false"
                app:errorText="@{vm.lastNameError}"
                app:errorTextAppearance="@style/errorTextApprearance"
                app:hintTextAppearance="@style/customHintApprearance"
                android:textColorHint="@color/color_6896ae">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLastName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
                    android:drawablePadding="@dimen/_13sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="35"
                    android:paddingBottom="@dimen/_13sdp"
                    android:singleLine="true"
                    android:text="@={vm.lastName}"
                    android:textColor="@color/color_4f4f4f"
                    android:textColorHighlight="@color/azure"
                    android:textSize="@dimen/_10sdp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/linear_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/input_lastname"
                android:layout_marginStart="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_18sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_14sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/gender"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="normal" />

                <RadioGroup
                    android:id="@+id/radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/tvMale"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/regist_male"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />

                    <RadioButton
                        android:id="@+id/tvFemale"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_26sdp"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/regist_female"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />

                    <RadioButton
                        android:id="@+id/tvOther"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_26sdp"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_5sdp"
                        android:text="@string/other"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />
                </RadioGroup>


            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:errorEnabled="false"
                app:errorText="@{vm.dobError}"
                android:textColorHint="@color/color_6896ae"
                app:hintTextAppearance="@style/customHintApprearance"
                app:errorTextAppearance="@style/errorTextApprearance"
                android:layout_below="@+id/linear_gender">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtBirth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:cursorVisible="false"
                    android:drawableStart="@drawable/ic_calender"
                    android:drawablePadding="@dimen/_14sdp"
                    android:focusable="false"
                    android:fontFamily="@font/roboto_regular"
                    android:hint="@string/regist_dob_hint"
                    android:inputType="none"
                    android:paddingBottom="@dimen/_14sdp"
                    android:singleLine="true"
                    android:textColor="@color/color_4f4f4f"
                    android:textColorHighlight="@color/azure"
                    android:textSize="@dimen/_10sdp" />
            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/nextSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_38sdp"
                android:background="@drawable/selector_blue_bg"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/next"
                android:textAllCaps="false"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_12sdp"
                android:textStyle="normal"
                app:dob="@{vm.dob}"
                app:firstName="@{vm.firstName}"
                app:gender="@{vm.gender}"
                app:lastName="@{vm.lastName}" />

        </RelativeLayout>
    </ScrollView>
</layout>
