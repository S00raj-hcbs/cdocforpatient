<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:cardElevation="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_2sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_appt">


            <RelativeLayout
                android:id="@+id/relCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView"
                    android:layout_width="@dimen/_45sdp"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginTop="@dimen/_11sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    app:cardCornerRadius="@dimen/_4sdp"
                    app:cardElevation="@dimen/_2sdp">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_doc"
                        android:scaleType="fitXY"/>

                </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <ImageView
                android:id="@+id/imgStatusPro"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:layout_alignEnd="@id/relCard"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:src="@drawable/ic_green_online"
                />
            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_13sdp"
                android:layout_toEndOf="@+id/relCard"
                android:fontFamily="@font/roboto_bold"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_11sdp" />


            <ImageView
                android:id="@+id/img_video_call"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_8sdp"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/video_call_icon"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/img_cancel"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:paddingStart="@dimen/_8sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:src="@drawable/cancel"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/imgChat"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:paddingStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_5sdp"
                android:paddingBottom="@dimen/_5sdp"
                android:src="@drawable/ic_email"
                app:tint="@color/azure"
                android:visibility="visible" />


            <TextView
                android:id="@+id/txtSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtName"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_toEndOf="@+id/relCard"
                android:fontFamily="@font/roboto_medium"
                android:lineSpacingExtra="@dimen/_1sdp"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_10sdp" />


            <RelativeLayout
                android:id="@+id/relative_upcomingappt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/relCard"
                android:layout_marginTop="@dimen/_10sdp"
                android:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtDateUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:drawableStart="@drawable/ic_cal2"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center|start"
                    android:text="1 april 2021, 12:15"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtApptType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:layout_below="@+id/txtDateUp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:gravity="bottom|start"
                    android:text="1 april 2021,"
                    android:visibility="gone"

                    android:textColor="@color/color_8f8f8f"
                    android:textSize="@dimen/_10sdp" />
                <!--            <LinearLayout-->
                <!--                android:id="@+id/end_view"-->
                <!--                android:layout_width="wrap_content"-->
                <!--                android:layout_height="wrap_content"-->
                <!--                android:layout_alignParentEnd="true"-->
                <!--                android:layout_centerVertical="true">-->

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtScheduled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:layout_alignParentEnd="true"
                    android:textAllCaps="false"
                    android:textColor="@color/tangerine"
                    android:visibility="visible"
                    android:textSize="@dimen/_10sdp" />


                <LinearLayout
                    android:id="@+id/rel_video_call"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtDateUp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:visibility="gone">
                    <RelativeLayout
                        android:id="@+id/btn_videocall"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_login_btn_selector"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/_8sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_videocam"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_28sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:layout_marginLeft="@dimen/_10sdp"
                                android:gravity="center_vertical"
                                android:text="@string/video_call"
                                android:textAllCaps="false"
                                android:textColor="@color/white_0_2"
                                android:visibility="visible"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rel_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_outline_blue"
                        android:gravity="center"
                        android:visibility="visible"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_8sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:gravity="center">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_28sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center_vertical"
                                android:text="@string/cancel"
                                android:textAllCaps="false"
                                android:textColor="@color/azure"
                                android:visibility="visible"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>


               <!-- <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/bg_logout"
                    android:drawableStart="@drawable/ic_videocam"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_8sdp"
                    android:text="@string/video_call"
                    android:textAllCaps="false"
                    android:textColor="@color/white_0_2"
                    android:visibility="visible"
                    android:textSize="@dimen/_10sdp" />-->
                <!--            </LinearLayout>-->

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/relative_past"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/relative_upcomingappt"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/_5sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:text="23 april,10am"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:textColor="@color/color_4f4f4f"
                    android:visibility="gone"
                    android:textSize="@dimen/_10sdp"
                    app:drawableStartCompat="@drawable/ic_cal2" />


                <LinearLayout
                    android:id="@+id/linear_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:visibility="gone"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/appt_duration"
                        android:textColor="@color/color_8f8f8f"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/txtTalkTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_9sdp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtDate"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/roboto_bold"
                    android:gravity="center"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:text="@string/complte"
                    android:textColor="@color/color_41c990"
                    android:textSize="@dimen/_11sdp" />
                <View
                    android:id="@+id/view"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:layout_below="@+id/txtDate"
                    android:layout_toEndOf="@+id/btn_status"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_centerVertical="true"
                    android:visibility="gone"
                    android:background="@drawable/vertical_line"/>
                <TextView
                    android:id="@+id/txtPastApptType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtDate"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_toEndOf="@+id/view"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/video_call_label"
                    android:visibility="gone"
                    android:textColor="@color/color_8f8f8f"
                    android:textSize="@dimen/_10sdp" />
                <TextView
                    android:id="@+id/label_txtCharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/btn_status"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/charged_amount"
                    android:textColor="@color/color_8f8f8f"
                    android:visibility="visible"
                    android:textSize="@dimen/_10sdp" />

                <TextView
                    android:id="@+id/txtCharge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/btn_status"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_toEndOf="@+id/label_txtCharge"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="visible"/>

               <!-- <Button
                    android:id="@+id/btnScheduled"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_below="@+id/label_txtCharge"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@drawable/bg_login_btn_selector"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:text="Reschedule"
                    android:textAllCaps="false"
                    android:paddingStart="@dimen/_8sdp"
                    android:paddingEnd="@dimen/_8sdp"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/_10sdp"
                    android:visibility="gone" />-->

                <LinearLayout
                    android:id="@+id/rel_Reschedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/label_txtCharge"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:visibility="visible">
                    <Button
                        android:id="@+id/btnScheduled"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_below="@+id/label_txtCharge"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_login_btn_selector"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="@string/reschedule"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:textAllCaps="false"
                        android:paddingStart="@dimen/_8sdp"
                        android:paddingEnd="@dimen/_8sdp"
                        android:textColor="@color/white_0_2"
                        android:textSize="@dimen/_10sdp"
                        android:visibility="visible" />


                    <RelativeLayout
                        android:id="@+id/rel_cancel2"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_outline_blue"
                        android:gravity="center"
                        android:visibility="visible"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:gravity="center">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_28sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center_vertical"
                                android:text="@string/cancel"
                                android:textAllCaps="false"
                                android:textColor="@color/azure"
                                android:visibility="visible"
                                android:textSize="@dimen/_10sdp" />
                        </LinearLayout>

                    </RelativeLayout>

                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/btn_past_videocall"
                    android:layout_width="match_parent"
                    android:layout_below="@+id/label_txtCharge"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:background="@drawable/bg_logout"
                    android:gravity="center"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_videocam"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_28sdp"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginLeft="@dimen/_10sdp"
                            android:gravity="center_vertical"
                            android:text="@string/video_call"
                            android:textAllCaps="false"
                            android:textColor="@color/white_0_2"
                            android:visibility="visible"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                </RelativeLayout>

            </RelativeLayout>

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/dot_online"
                android:visibility="gone" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>



</layout>