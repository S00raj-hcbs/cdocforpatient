<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white_0_2">

    <LinearLayout
        android:id="@+id/cardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_9sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_9sdp"
            app:cardCornerRadius="@dimen/_30sdp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_doc"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgStatus"
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_alignEnd="@id/cardView"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp" />

    <TextView
        android:id="@+id/txtName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_13sdp"
        android:layout_toEndOf="@+id/cardView"
        android:fontFamily="@font/roboto_medium"
        android:text="csdcs"
        android:textColor="@color/black_2_1"
        android:textSize="@dimen/_11sdp" />

    <LinearLayout
        android:id="@+id/linear_rating"
        android:layout_width="@dimen/_54sdp"
        android:layout_height="@dimen/_16sdp"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_below="@+id/cardView"
        android:visibility="gone"
        android:background="@color/color_ecf6fb"
        android:paddingStart="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_13sdp"
        android:paddingEnd="@dimen/_4sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgstar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/star"/>

        <TextView
            android:id="@+id/ratingNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginEnd="@dimen/_3sdp"
            android:layout_marginStart="@dimen/_3sdp"
            android:textColor="@color/dark_slate_blue"
            android:textSize="@dimen/_10sdp"
            />
    </LinearLayout>





    <ImageView
        android:id="@+id/favoriteIcon"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_fav_heart_select" />

    <TextView
        android:id="@+id/txtSpecialty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtName"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_35sdp"
        android:layout_toEndOf="@+id/cardView"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_medium"
        android:lineSpacingExtra="@dimen/_1sdp"
        android:maxLines="1"
        android:text="Speciality"
        android:textColor="@color/color_8f8f8f"
        android:textSize="@dimen/_10sdp" />

    <ImageView
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_below="@+id/favoriteIcon"
        android:layout_alignEnd="@+id/txtDpmt"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:src="@drawable/ic_right_arrow" />

    <TextView
        android:id="@+id/txtDpmt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/txtSpecialty"
        android:layout_marginTop="@dimen/_9sdp"
        android:layout_toEndOf="@+id/cardView"
        android:layout_marginLeft="@dimen/_55sdp"
        android:fontFamily="@font/roboto_regular"

        android:text="lang"
        android:textColor="@color/color_8f8f8f"
        android:textSize="@dimen/_9sdp" />

    <RelativeLayout
        android:id="@+id/rel_rating"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_minus25sdp"
        android:layout_below="@+id/txtSpecialty"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_toEndOf="@+id/cardView"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/ratingBar"
            style="@style/ratingBar2"
            android:secondaryProgressTint="@color/azure"
            android:progressTint="@color/azure"
            android:progressBackgroundTint="@color/azure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:scaleY="0.5"
            android:scaleX="0.5"
            android:isIndicator="true"
            tools:ignore="MissingConstraints"/>
    </RelativeLayout>

    <TextView
        android:id="@+id/btnMakeAppointment"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="@dimen/_30sdp"
        android:layout_below="@+id/txtDpmt"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/_40sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginRight="@dimen/_14sdp"
        android:layout_toRightOf="@+id/linear_rating"
        android:background="@drawable/bg_appointment"
        android:gravity="center"
        android:text="Make an appointment"
        android:textAllCaps="false"
        android:textColor="@color/white_0_2"
        android:textSize="@dimen/_12sdp" />

</RelativeLayout>


