<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_14sdp"
    android:layout_marginEnd="@dimen/_14sdp"
    android:layout_marginVertical="@dimen/_10sdp">

    <TextView
        android:id="@+id/commentTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:text="Dr. Jinping did a great job with my first ever health exam. She explained everything to me in a very clear manner. She was also kind and friendly."
        android:textColor="@color/color_4f4f4f"
        android:textSize="@dimen/_10sdp"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:layout_marginVertical="@dimen/_5sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rel_rating" />


    <TextView
        android:id="@+id/userRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:text="4.6"
        android:textColor="@color/dark_slate_blue"
        android:textSize="@dimen/_10sdp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/star"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/white_0_2"
        android:padding="@dimen/_2sdp"
        android:drawablePadding="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_3sdp"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/rel_rating"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_minus16sdp"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints">

        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/ratingBar"
            style="@style/ratingBar2"
            android:secondaryProgressTint="@color/azure"
            android:progressTint="@color/azure"
            android:progressBackgroundTint="@color/azure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:scaleY="0.7"
            android:scaleX="0.7"
            android:isIndicator="true"
            tools:ignore="MissingConstraints"/>
    </RelativeLayout>


    <TextView
        android:id="@+id/dateTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_regular"
        android:text="New York  |  22 Dec, 2020"
        android:textColor="@color/color_8f8f8f"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_3sdp"
        app:layout_constraintTop_toTopOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>