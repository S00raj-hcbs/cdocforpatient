<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_18sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:background="@color/white_0_2"
    android:elevation="@dimen/_3sdp"
    android:orientation="vertical"
    app:cardCornerRadius="@dimen/_3sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_9sdp"
        android:layout_marginEnd="@dimen/_9sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_3sdp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/term_of_use"
            android:textColor="@color/dark_slate_blue"
            android:textSize="@dimen/_12sdp"
            android:layout_centerHorizontal="true"
            android:textStyle="bold" />

        <ScrollView
            android:layout_below="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:minWidth="300dp"
                    android:text="@string/terms_message"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_12sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/tv_left"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_outline_blue"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="@string/btn_ok"
                        android:textAllCaps="false"
                        android:textColor="@color/azure"
                        android:textSize="@dimen/_12sdp" />

                    <Button
                        android:id="@+id/tv_right"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:background="@drawable/ic_filled_blue_bg"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:textAllCaps="false"
                        android:textColor="@color/white_0_2"
                        android:textSize="@dimen/_12sdp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </RelativeLayout>
</androidx.cardview.widget.CardView>