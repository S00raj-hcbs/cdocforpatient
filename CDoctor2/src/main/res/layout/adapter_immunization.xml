<layout>
    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        app:cardCornerRadius="@dimen/dimen_5dp"
        app:cardElevation="@dimen/_2sdp"
        android:background="@color/white_0_2">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/relative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_5sdp"
        android:layout_gravity="center"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/lab_circular"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/lab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:src="@drawable/ic_doc" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/linear1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_toStartOf="@+id/txtDate"
            android:layout_toEndOf="@+id/lab_circular"
            android:gravity="center"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:orientation="vertical">


        </LinearLayout>


        <TextView
            android:id="@+id/txt_receiver_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginBottom="@dimen/_2sdp"
            android:layout_toStartOf="@+id/txtDate"
            android:layout_toEndOf="@+id/lab_circular"
            android:gravity="start"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/color_4f4f4f"
            android:textSize="@dimen/_10sdp"
            android:visibility="visible" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_receiver_name"
            android:layout_toEndOf="@+id/lab_circular"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_8sdp">
            <TextView
                android:id="@+id/txt_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:gravity="start"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_toStartOf="@+id/txtNum"
                android:textColor="@color/color_8f8f8f"
                android:textSize="@dimen/_10sdp" />
            <TextView
                android:id="@+id/txtNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="@dimen/_8sdp"
                android:background="@drawable/ic_message_num"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:paddingStart="@dimen/_2sdp"
                android:paddingEnd="@dimen/_2sdp"
                android:text="2"
                android:textColor="@color/white_0_2"
                android:textSize="@dimen/_10sdp"
                android:visibility="visible" />
        </RelativeLayout>


        <TextView
            android:id="@+id/txtDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:fontFamily="@font/roboto_regular"
            android:textColor="@color/color_4f4f4f"
            android:textSize="@dimen/_10sdp" />




    </RelativeLayout>
    </androidx.cardview.widget.CardView>
</layout>