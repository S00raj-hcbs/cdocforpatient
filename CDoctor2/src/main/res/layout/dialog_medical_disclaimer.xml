<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_24sdp"
    android:background="@drawable/bg_disclaimer_dialog">

    <ImageView
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="#1976D2" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medical Disclaimer"
        android:textSize="@dimen/_16sdp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginTop="@dimen/_16sdp"/>

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/_12sdp"
        android:textColor="#444444"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_20sdp"/>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:background="@drawable/bg_login_btn_selector"
            android:backgroundTint="#1976D2"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:layout_weight="1.1"
            android:paddingBottom="@dimen/_3sdp"
            android:text="I Understand"
            android:textAllCaps="false"
            android:textColor="@color/white_0_2"
            android:textSize="@dimen/_12sdp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:background="@drawable/bg_outline_trans_blue"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:layout_weight="1"
            android:visibility="gone"
            android:paddingBottom="@dimen/_3sdp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#1976D2"
            android:textSize="@dimen/_12sdp" />

    </LinearLayout>

</LinearLayout>