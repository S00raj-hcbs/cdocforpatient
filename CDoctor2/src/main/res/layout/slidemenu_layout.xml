<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/azure"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/lin_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            android:background="@color/azure"
            android:gravity="center_vertical">

            <RelativeLayout
                android:id="@+id/doc_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:id="@+id/cardView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_13sdp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_margin="@dimen/_2sdp"
                        app:cardCornerRadius="@dimen/_20sdp">

                        <ImageView
                            android:id="@+id/patient_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@color/color_dceffd"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_doc" />

                    </androidx.cardview.widget.CardView>
                </LinearLayout>


                <ImageView
                    android:id="@+id/imgStatus"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:src="@drawable/ic_green_online"
                    android:layout_alignEnd="@id/cardView"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_1sdp" />

            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical">
                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/doc_name"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="normal" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/view_bg"
            android:layout_below="@+id/lin_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:background="@color/white_0_2"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_below="@+id/view_bg"
            android:id="@+id/recyclerview_menus"
            android:layout_above="@+id/label_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <TextView
            android:id="@+id/label_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/white_0_2"
            android:layout_alignParentBottom="true"
            android:text="Copyright © 2026 - CyberMed Health Inc."
            android:layout_marginBottom="@dimen/_10sdp"/>
        <TextView
            android:id="@+id/label_text"
            android:layout_above="@+id/label_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:layout_marginBottom="@dimen/_3sdp"
            android:textColor="@color/white_0_2"
            />
    </RelativeLayout>
</layout>