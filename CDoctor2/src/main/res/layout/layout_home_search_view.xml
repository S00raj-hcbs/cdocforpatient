<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_0_2"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_14sdp"
            android:fontFamily="@font/roboto_medium"
            android:text="@string/search_doctor_label"
            android:textColor="@color/dark_slate_blue"
            android:textSize="@dimen/_12sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_search_bg"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_14sdp">

            <TextView
                android:id="@+id/txtSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawablePadding="@dimen/_10sdp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center|start"
                android:padding="@dimen/_8sdp"
                android:text="@string/search_by_first_or_last_name"
                android:textColor="@color/color_6896ae"
                android:textSize="@dimen/_12sdp"
                app:drawableStartCompat="@drawable/ic_search"
                android:layout_weight="1"
                android:onClick="onClick"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2sdp"
                android:background="@drawable/ic_line" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_see_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:background="@drawable/bg_logout"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="@string/view_all_doctors"
            android:textAllCaps="false"
            android:textColor="@color/white_0_2"
            android:textSize="@dimen/_12sdp"
            android:onClick="onClick"/>

    </LinearLayout>
</layout>
