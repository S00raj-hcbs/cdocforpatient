<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />


        <import type="java.util.Map" />


        <variable
            name="DeviceKey"
            type="com.cybermed.cdoc_patient.bluetooth.iHealth_Devices.smartwatch.swUtil.SWKeyConstant" />

        <variable
            name="map"
            type="Map&lt;String, String&gt;" />

        <variable
            name="isConnected"
            type="androidx.lifecycle.MutableLiveData&lt;Boolean&gt;" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azure"
            android:minHeight="?android:attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/back_arrow"
            app:theme="@style/ThemeOverlay.AppCompat">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/health_status"
                    android:textColor="@color/white_0_2"
                    android:textSize="@dimen/_14sdp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgGraph"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/dimen_15dp"
                        android:src="@drawable/graph"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgConnect"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="@dimen/_11sdp"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/smart_watch_ic"
                        app:tint="@color/white_0_2" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:id="@+id/txt_loader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22sdp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">


            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:indeterminateDrawable="@drawable/circle_progress_dark_slate" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/retrieving_data_from_the_watch"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_10sdp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_29sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_loader"
            app:layout_goneMarginTop="@dimen/_28sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/top_circular_bars"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/linear_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_16sdp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="@dimen/_70sdp"
                            android:layout_height="@dimen/_70sdp"
                            android:background="@drawable/ic_circle_outline"
                            android:backgroundTint="@color/tangerine"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/_23sdp"
                            android:paddingTop="@dimen/_16sdp"
                            android:paddingEnd="@dimen/_23sdp"
                            android:paddingBottom="@dimen/_10sdp">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/sw_distance" />

                            <TextView
                               android:id="@+id/distanceCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center_horizontal"
                                android:textColor="@color/dark_slate_blue"
                                android:textSize="@dimen/_12sdp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center_horizontal"
                            android:text="@string/distance"
                            android:textColor="#4f4f4f"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                       >

                        <LinearLayout
                            android:layout_width="@dimen/_90sdp"
                            android:layout_height="@dimen/_90sdp"
                            android:background="@drawable/ic_circle_outline"
                            android:backgroundTint="@color/azure"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/_23sdp"
                            android:paddingTop="@dimen/_18sdp"
                            android:paddingEnd="@dimen/_23sdp"
                            android:paddingBottom="@dimen/_8sdp">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/sw_footsteps" />

                            <TextView
                                android:id="@+id/footStepCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center_horizontal"
                                android:textColor="@color/dark_slate_blue"
                                android:textSize="@dimen/_14sdp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center_horizontal"
                            android:text="@string/steps"
                            android:textColor="#4f4f4f"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_calories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:orientation="vertical"
                        >
                        <LinearLayout
                            android:layout_width="@dimen/_70sdp"
                            android:layout_height="@dimen/_70sdp"
                            android:background="@drawable/ic_circle_outline"
                            android:backgroundTint="@color/dark_slate_blue"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/_23sdp"
                            android:paddingTop="@dimen/_16sdp"
                            android:paddingEnd="@dimen/_23sdp"
                            android:paddingBottom="@dimen/_10sdp">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/sw_calories" />

                            <TextView
                                android:id="@+id/calorieCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center_horizontal"
                                android:textColor="@color/dark_slate_blue"
                                android:textSize="@dimen/_12sdp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/roboto_regular"
                            android:gravity="center_horizontal"
                            android:text="@string/calories"
                            android:textColor="#4f4f4f"
                            android:textSize="@dimen/_10sdp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_14sdp"
                    android:layout_marginEnd="@dimen/_14sdp"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/layout_bloodpressure"
                        layout="@layout/sw_item_bloodpressure"
                        app:isConnected="@{isConnected}"
                        app:map="@{map}" />

                    <include
                        android:id="@+id/layout_daily"
                        layout="@layout/sw_item_dailyactivity"
                        app:isConnected="@{isConnected}"
                        app:map="@{map}" />

                    <include
                        android:id="@+id/layout_temp"
                        layout="@layout/sw_item_temp"
                        app:isConnected="@{isConnected}"
                        app:map="@{map}" />

                    <include
                        android:id="@+id/layout_hrv"
                        layout="@layout/sw_item_hrv"
                        app:isConnected="@{isConnected}"
                        app:map="@{map}" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>