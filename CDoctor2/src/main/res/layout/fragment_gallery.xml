<layout>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:layoutDirection="ltr">
<!--    android:background="@android:color/black"-->

    <androidx.viewpager.widget.ViewPager
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/photo_view_pager"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/img_photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cutout_safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/back_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="32sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="@dimen/_10sdp"
            android:background="@drawable/white_circle"
            app:srcCompat="@drawable/ic_back_btn" />

        <Button
            android:id="@+id/retake"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/done"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_width="@dimen/_139sdp"
            android:layout_height="@dimen/_28sdp"
            android:text="@string/retake"
            android:textAllCaps="false"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/roboto_medium"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_outline_blue"
            android:textColor="@color/azure"
            app:srcCompat="@drawable/ic_share" />

        <Button
            android:id="@+id/done"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/retake"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_32sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:layout_width="@dimen/_139sdp"
            android:layout_height="@dimen/_28sdp"
            android:text="@string/use_it"
            android:scaleType="fitCenter"
            android:textColor="@color/white_0_2"
            android:textAllCaps="false"
            android:textSize="@dimen/_12sdp"
            android:fontFamily="@font/roboto_medium"
            android:background="@drawable/bg_login_btn_selector"
            app:srcCompat="@drawable/ic_delete" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>
