<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.cybermed.cdoc_patient.main.MainActVm" />

        <import type="android.view.View" />
    </data>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_0_4"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blue_0_4"
            android:orientation="vertical"
            tools:context=".login.homeScreen.HomeFragment">

            <include
                android:id="@+id/layout_home_viewpager"
                layout="@layout/layout_home_viewpager"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_weight="0.58"
                android:layout_height="match_parent" />

            <include
                android:id="@+id/layout_home_search_view"
                layout="@layout/layout_home_search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="0.42"
                android:visibility="visible">
                <RelativeLayout
                    android:id="@+id/relative_upcomingappt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/blue_0_4"
                    >

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/upcoming_appt"
                        android:textColor="@color/dark_slate_blue"
                        android:textSize="@dimen/_12sdp"
                        android:visibility="@{vm.apptModelLiveData.futureViewListSize>0?View.VISIBLE:View.GONE}"/>

                    <TextView
                        android:id="@+id/txtViewUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_22sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:onClick="onClick"
                        android:text="@string/view_all"
                        android:textColor="@color/azure"
                        android:textSize="@dimen/_9sdp"
                        android:visibility="@{vm.apptModelLiveData.futureViewListSize>0?View.VISIBLE:View.GONE}"/>

                    <ProgressBar
                        android:id="@+id/progress_up"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/txtViewUp"
                        android:layout_centerInParent="true"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:id="@+id/relativeUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/progress_up"
                        android:visibility="visible">

                        <FrameLayout
                            android:id="@+id/container_upcoming"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/_2sdp"
                            />


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:layout_marginEnd="@dimen/_14sdp"
                            android:layout_marginBottom="@dimen/_2sdp"
                            android:gravity="center"
                            android:visibility="@{vm.apptModelLiveData.futureViewListSize==0?View.VISIBLE:View.GONE}">
                            <ImageView
                                android:id="@+id/no_cal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:layout_marginBottom="@dimen/_3sdp"
                                android:src="@drawable/cal_no_appt"
                                android:layout_centerHorizontal="true" />

                            <TextView
                                android:id="@+id/txt_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_medium"
                                android:gravity="center"
                                android:visibility="visible"
                                android:layout_below="@+id/no_cal"
                                android:text="@string/sorry"
                                android:textColor="@color/black_2_1"
                                android:textSize="@dimen/_11sdp" />

                            <TextView
                                android:id="@+id/txt_message"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/txt_title"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:layout_centerInParent="true"
                                android:lineSpacingExtra="@dimen/_2sdp"
                                android:text="@string/there_have_been_no_appointments_for_today"
                                android:textColor="@color/black_2_1"
                                android:textSize="@dimen/_10sdp" />

                        </RelativeLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/_14sdp"
                            android:layout_marginTop="@dimen/_minus3sdp"
                            android:background="@color/gray_0_4"
                            android:layout_below="@+id/container_upcoming"/>
                        <!--                    app:setHeight="@{vm.apptModelLiveData.futureViewListSize==2?@dimen/_230sdp:@dimen/_120sdp}"-->
                    </RelativeLayout>

                </RelativeLayout>




                <include
                    android:id="@+id/layout_home_vital"
                    layout="@layout/layout_home_vital"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>

                <RelativeLayout
                    android:id="@+id/relative_past"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/blue_0_4"
                    android:visibility="@{vm.apptModelLiveData.pastViewListSize>0?View.VISIBLE:View.GONE}">

                    <TextView
                        android:id="@+id/title_past"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_14sdp"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:text="@string/book_from_your_recent_appointments"
                        android:textColor="@color/dark_slate_blue"
                        android:textSize="@dimen/_12sdp" />

                    <TextView
                        android:id="@+id/txtViewPast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:layout_marginEnd="@dimen/_22sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:onClick="onClick"
                        android:text="@string/view_all"
                        android:textColor="@color/azure"
                        android:textSize="@dimen/_9sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/title_past"
                        android:layout_marginBottom="@dimen/_38sdp">

                        <ProgressBar
                            android:id="@+id/progress_past"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/container_past"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:setHeight="@{vm.apptModelLiveData.pastViewListSize==2?@dimen/_300sdp:@dimen/_160sdp}"
                            />
                        <!--                    app:setHeight="@{vm.apptModelLiveData.pastViewListSize==2?@dimen/_310sdp:@dimen/_160sdp}" -->
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</layout>