<layout>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
     >
        <ImageView
            android:id="@+id/img_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_pdfview"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_24sdp"/>

        <TextView
            android:id="@+id/refer_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_toRightOf="@id/img_pdf"
            android:textColor="@color/color_4f4f4f"
            android:textSize="@dimen/_10sdp"
            android:gravity="start"
            android:text="Dr. Samantha Williamson"
            android:fontFamily="@font/roboto_medium"/>
        <TextView
            android:id="@+id/txt_view_pdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_24sdp"
            android:layout_alignParentEnd="true"
            android:text="@string/view"
            android:background="@drawable/pdf_bg"
            android:textColor="@color/white_0_2"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/roboto_medium"
            android:textStyle="normal"
            android:gravity="center"/>

        <TextView
            android:id="@+id/referral_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/refer_from"
            android:layout_toRightOf="@id/img_pdf"
            android:layout_marginStart="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="@dimen/_20sdp"
            android:text="02/24/2021"
            android:textColor="@color/color_8f8f8f"
            android:fontFamily="@font/roboto_regular"
            android:textStyle="normal"
            android:textSize="@dimen/_10sdp"/>


    </RelativeLayout>
</layout>