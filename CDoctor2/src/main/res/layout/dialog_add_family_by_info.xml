            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_birth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                app:hintEnabled="false"
                app:errorTextAppearance="@style/errorTextApprearance"
                android:textColorHint="@color/color_6896ae"
                app:hintTextAppearance="@style/customHintApprearance">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtBirth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:hint="@string/regist_dob_hint"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:textColor="@color/color_4f4f4f"
                    android:textColorHint="@color/color_6896ae"
