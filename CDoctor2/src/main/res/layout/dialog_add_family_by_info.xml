            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_zipcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                app:hintEnabled="false"
                app:errorTextAppearance="@style/errorTextApprearance"
                android:textColorHint="@color/color_6896ae"
                app:hintTextAppearance="@style/customHintApprearance">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editZipCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center_vertical"
                    android:inputType="text"
                    android:hint="@string/regist_zip"
                    android:maxLength="5"
                    android:singleLine="true"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:textColor="@color/color_4f4f4f"
                    android:textColorHint="@color/color_6896ae"
                    android:textSize="@dimen/_10sdp"
                    android:imeOptions="actionDone"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/linear_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/gender"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="normal" />

                <RadioGroup
                    android:id="@+id/radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center|start"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/tvMale"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_3sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:text="@string/regist_male"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />

                    <RadioButton
                        android:id="@+id/tvFemale"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/regist_female"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />

                    <RadioButton
                        android:id="@+id/tvOther"
                        style="@style/CdocRadioButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:padding="@dimen/_3sdp"
                        android:text="@string/other"
                        android:textColor="@color/color_4f4f4f"
                        android:textSize="@dimen/_10sdp"
                        android:textStyle="normal" />
                </RadioGroup>


            </LinearLayout>


            <Button
                android:id="@+id/btn_search_family"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_18sdp"
                android:textSize="@dimen/_10sdp"
                android:background="@drawable/bg_login_btn_selector"
                android:text="@string/search"
                android:textAllCaps="false"
                android:textColor="@color/white_0_2" />


        </LinearLayout>
