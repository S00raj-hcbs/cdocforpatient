<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.cybermed.cdoc_patient.main.MainActVm" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.cybermed.cdoc_patient.util.SlideMenu
            android:id="@+id/slidmenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
           android:visibility="visible" >

            <include
                android:id="@+id/layout_slidemenu"
                layout="@layout/slidemenu_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <include
                        android:id="@+id/toolbar"
                        layout="@layout/layout_home_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:vm="@{vm}" />

                    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                        android:id="@+id/pullToRefresh"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                           <!-- <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1.1">-->

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:background="@color/blue_0_4"
                                    android:layout_weight="1">
                                    <include
                                        android:id="@+id/layout_home_viewpager"
                                        layout="@layout/layout_home_viewpager"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0.58"
                                        app:vm="@{vm}"
                                        android:visibility="gone"
                                        tools:ignore="NestedWeights" />

                                    <include
                                        android:id="@+id/viewAppt"
                                        layout="@layout/home_frag_appt"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        app:vm="@{vm}"/>


                                </LinearLayout>
                           <!-- </ScrollView>-->

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@color/blue_0_4">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:layout_marginLeft="@dimen/_5sdp"
                                    android:layout_marginRight="@dimen/_5sdp"
                                    android:layout_marginBottom="@dimen/_10sdp"
                                    android:weightSum="3">


                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/blue_0_4"
                                        android:orientation="horizontal"
                                        android:layout_marginHorizontal="@dimen/_5sdp"
                                        android:layout_weight="1"
                                        android:weightSum="2">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_Myappoinments"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">

                                                <ImageView
                                                    android:layout_width="@dimen/_24sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/calendar_ic" />
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/appointments"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>

                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_vitalmonitoring"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">
                                                <ImageView
                                                    android:layout_width="@dimen/_26sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/btn_vital"
                                                    />
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/vitals"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>

                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/blue_0_4"
                                        android:orientation="horizontal"
                                        android:layout_marginHorizontal="@dimen/_5sdp"
                                        android:layout_weight="1"
                                        android:weightSum="2">
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_find_pharmacy"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">
                                                <ImageView
                                                    android:layout_width="@dimen/_26sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/btn_pharmacy"
                                                    />
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/find_a_pharmacy_2"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>

                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_search_doctors"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">
                                                <ImageView
                                                    android:layout_width="@dimen/_24sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/ic_doc"
                                                    />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/find_provider"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>
                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/blue_0_4"
                                        android:orientation="horizontal"
                                        android:weightSum="2"
                                        android:layout_marginHorizontal="@dimen/_5sdp"
                                        android:layout_weight="1">
                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_health_records"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">
                                                <ImageView
                                                    android:layout_width="@dimen/_24sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/no_lab_report"
                                                    />
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/my_health_record"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>

                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_weight="1"
                                            android:id="@+id/card_document"
                                            android:onClick="onClick"
                                            app:cardCornerRadius="@dimen/_5sdp"
                                            android:layout_margin="@dimen/_5sdp">
                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="match_parent"
                                                android:orientation="vertical"
                                                android:layout_gravity="center"
                                                android:gravity="center">
                                                <ImageView
                                                    android:layout_width="@dimen/_24sdp"
                                                    android:layout_height="@dimen/_24sdp"
                                                    android:src="@drawable/file_ic"
                                                    />
                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="@dimen/_8sdp"
                                                    android:text="@string/my_documents"
                                                    android:textSize="@dimen/_10sdp"
                                                    android:textColor="@color/color_4f4f4f"
                                                    android:fontFamily="@font/roboto_bold"/>

                                            </LinearLayout>

                                        </androidx.cardview.widget.CardView>

                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>



                </LinearLayout>
                <ImageView
                    android:id="@+id/img_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_46sdp"
                    android:onClick="onClick"
                    android:visibility="gone"/>
            </RelativeLayout>

        </com.cybermed.cdoc_patient.util.SlideMenu>

