<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tablet_ic_background">

        <TextView
            android:id="@+id/txtCompanyName"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_48sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="center"
            android:text="CyberMed"
            android:textColor="@color/dark_slate_blue"
            android:textSize="@dimen/_14sdp"
            />

        <HorizontalScrollView
            android:id="@+id/devices_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/call_img"
            android:layout_below="@+id/txtCompanyName"
            android:fillViewport="false"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:orientation="horizontal">

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/blood_pressure"
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/white_circle"
                        android:elevation="0dp"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp">

                        <Button
                            android:id="@+id/imgBp"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:layout_gravity="center"
                            android:background="@drawable/tablet_ic_disabled_bp" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_bp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Blood Pressure"
                        android:textColor="@color/dark_slate_blue_40_opacity"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/pulse_oximeter"
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/white_circle"
                        android:elevation="0dp"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp">

                        <Button
                            android:id="@+id/img_pulse"
                            android:layout_width="@dimen/_32sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:layout_gravity="center"
                            android:background="@drawable/tablet_ic_disabled_pulse" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_pulse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Pulse Oximeter"
                        android:textColor="@color/dark_slate_blue_40_opacity"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/stemoscope"
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/white_circle"
                        android:elevation="0dp"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp">

                        <Button
                            android:id="@+id/imgsStemo"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:layout_gravity="center"
                            android:background="@drawable/tablet_ic_disbaled_stemo" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_stemo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Stemoscope"
                        android:textColor="@color/dark_slate_blue_40_opacity"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/glucometer"
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/white_circle"
                        android:elevation="0dp"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp">

                        <Button
                            android:id="@+id/imggluco"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_27sdp"
                            android:layout_gravity="center"
                            android:background="@drawable/tablet_ic_disabled_gluco" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_gluco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Glucometer"
                        android:textColor="@color/dark_slate_blue_40_opacity"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>

                <LinearLayout

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_25sdp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/scale"
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:background="@drawable/white_circle"
                        android:elevation="0dp"
                        android:gravity="center"
                        android:padding="@dimen/_5sdp"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp">

                        <Button
                            android:id="@+id/imgscale"
                            android:layout_width="@dimen/_27sdp"
                            android:layout_height="@dimen/_25sdp"
                            android:layout_gravity="center"
                            android:background="@drawable/tablet_ic_disabled_weight" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/txt_scale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:fontFamily="@font/roboto_medium"
                        android:gravity="center"
                        android:text="Scale"
                        android:textColor="@color/dark_slate_blue_40_opacity"
                        android:textSize="@dimen/_8sdp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <RelativeLayout
            android:id="@+id/call_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">

            <TextView
                android:id="@+id/onlineDocCountTxt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_15sdp"
                android:fontFamily="@font/roboto_medium"
                android:gravity="center"
                android:text="@string/current_online_providers"
                android:textColor="@color/color_4f4f4f"
                android:textSize="@dimen/_12sdp" />

            <ImageView
                android:id="@+id/docList"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/onlineDocCountTxt"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_15sdp"
                android:adjustViewBounds="true"
                android:src="@drawable/tablet_ic_doctor" />
        </RelativeLayout>

        <TextView
            android:id="@+id/system_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="bottom"
            android:text="Version Code: "
            android:textColor="@color/color_4f4f4f"
            android:textSize="@dimen/_7sdp"

            />
        <TextView
            android:id="@+id/cybermed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:fontFamily="@font/roboto_medium"
            android:gravity="bottom"
            android:text="Powered by CyberMed Health Inc."
            android:textColor="@color/color_4f4f4f"
            android:textSize="@dimen/_7sdp"

            />

    </RelativeLayout>
</layout>
