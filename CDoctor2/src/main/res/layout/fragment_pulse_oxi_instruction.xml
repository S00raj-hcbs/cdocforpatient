<?xml version="1.0" encoding="utf-8"?>
<layout>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scrollbars="horizontal"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_ecf6fb"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/linear_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgDevice"
                    android:layout_width="@dimen/_195sdp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/rpm_oximeter_instruction1" />

                <TextView
                    android:id="@+id/txtmessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_19sdp"
                    android:layout_marginEnd="@dimen/_20sdp"
                    android:fontFamily="@font/roboto_medium"
                    android:gravity="center"
                    android:text="@string/iot_oximeter_instruction"
                    android:textColor="@color/dark_slate_blue"
                    android:textSize="@dimen/_12sdp" />

                <TextView
                    android:id="@+id/searching_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_55sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_55sdp"
                    android:fontFamily="@font/roboto_regular"
                    android:gravity="center"
                    android:text="@string/iot_searching"
                    android:textColor="@color/color_4f4f4f"
                    android:textSize="@dimen/_10sdp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_quit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               android:layout_below="@+id/linear_top"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_marginEnd="@dimen/_14sdp"
                android:layout_marginBottom="@dimen/_38sdp"
                android:layout_marginTop="@dimen/_36sdp"
                android:background="@drawable/bg_outline_trans_blue"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/iot_quit"
                android:textAllCaps="false"
                android:textColor="@color/azure"
                android:textSize="@dimen/_12sdp" />
        </RelativeLayout>
    </ScrollView>
</layout>